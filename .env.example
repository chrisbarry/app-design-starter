# Copy to .env.local and fill in. Leave the Firebase values empty to run without the review layer.
# Get these with: firebase apps:sdkconfig WEB
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Keeps this prototype's comments apart from others sharing the same Firebase project
VITE_REVIEW_PROJECT=my-app
# Optional shared password for reviewers (it ends up in the page bundle, so it's a gate, not security)
VITE_REVIEW_PASSWORD=
VITE_REVIEW_TITLE=My app design prototype
